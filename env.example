# Example environment for status-writer.
# STATUS_ROOT must be set in the environment (shell profile, system variables, or the
# "env" block of Claude Code's settings.json), because the skill needs it to find this file.
# A .env inside STATUS_ROOT may then override the two optional paths below.

STATUS_ROOT=/path/to/your/status-root
STATUS_PROJECTS_DIR=${STATUS_ROOT}/projects
STATUS_SUMMARY_FILE=${STATUS_ROOT}/summary.md
